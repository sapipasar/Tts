<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TTS Indo - Pria & Wanita</title>
    <style>
        body { font-family: sans-serif; background: #0f172a; color: white; display: flex; justify-content: center; padding: 20px; }
        .card { background: #1e293b; padding: 25px; border-radius: 20px; width: 100%; max-width: 400px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        h2 { text-align: center; color: #38bdf8; margin-bottom: 20px; }
        label { display: block; margin-top: 15px; font-size: 13px; color: #94a3b8; }
        textarea { width: 100%; height: 100px; background: #0f172a; color: white; border: 1px solid #334155; border-radius: 10px; padding: 12px; box-sizing: border-box; margin-top: 5px; resize: none; }
        select, input { width: 100%; padding: 12px; background: #334155; color: white; border: none; border-radius: 8px; margin-top: 5px; }
        .btn-group { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; }
        button { padding: 15px; border: none; border-radius: 10px; font-weight: bold; cursor: pointer; }
        #playBtn { background: #0ea5e9; color: white; }
        #dlBtn { background: #22c55e; color: white; }
        button:disabled { background: #475569; opacity: 0.6; }
        #status { text-align: center; margin-top: 15px; font-size: 13px; color: #38bdf8; }
    </style>
</head>
<body>

<div class="card">
    <h2>TTS Indonesia Pro</h2>
    
    <label>Tulis Teks:</label>
    <textarea id="txt" placeholder="Contoh: Halo pripun kabare mas?"></textarea>

    <label>Pilih Suara:</label>
    <select id="voiceSelect">
        <option value="id-ID">Wanita Indonesia (Standar)</option>
        <option value="pria">Pria Indonesia (Deep)</option>
        <option value="jawa">Logat Jawa (Slow & Medok)</option>
    </select>

    <div class="btn-group">
        <button id="playBtn">CEK SUARA</button>
        <button id="dlBtn">DOWNLOAD MP3</button>
    </div>

    <div id="status">Pilih suara lalu klik Cek.</div>
</div>

<script>
    const playBtn = document.getElementById('playBtn');
    const dlBtn = document.getElementById('dlBtn');
    const txt = document.getElementById('txt');
    const voiceSelect = document.getElementById('voiceSelect');
    const status = document.getElementById('status');

    let audioBlob = null;

    // Fungsi untuk memicu TTS
    const speak = (isDownload = false) => {
        const text = txt.value;
        if (!text) return alert("Isi teks dulu!");

        status.innerText = "Memproses suara...";
        
        // Setting suara berdasarkan pilihan
        const choice = voiceSelect.value;
        let pitch = 1.0;
        let rate = 1.0;

        if (choice === "pria") {
            pitch = 0.5; // Suara lebih berat/pria
            rate = 0.9;
        } else if (choice === "jawa") {
            pitch = 0.9;
            rate = 0.7; // Lebih lambat agar logatnya terasa
        }

        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'id-ID';
        utterance.pitch = pitch;
        utterance.rate = rate;

        utterance.onstart = () => { status.innerText = "Suara sedang diputar..."; };
        utterance.onend = () => { status.innerText = "Selesai."; };

        window.speechSynthesis.speak(utterance);

        // Catatan: Browser Mobile tidak mengizinkan simpan file langsung dari SpeechSynthesis.
        // Sebagai solusinya, kita gunakan API eksternal untuk proses Download agar menjadi file asli.
        if (isDownload) {
            const ttsUrl = `https://translate.google.com/translate_tts?ie=UTF-8&q=${encodeURIComponent(text)}&tl=id&client=tw-ob&ttsspeed=${rate}`;
            const a = document.createElement('a');
            a.href = ttsUrl;
            a.target = "_blank";
            a.download = "suara_tts.mp3";
            a.click();
            status.innerText = "Membuka link download...";
        }
    };

    playBtn.onclick = () => speak(false);
    dlBtn.onclick = () => speak(true);

</script>

</body>
</html>
